# Rebound Environment Configuration Template
# DO NOT commit production secrets to version control.

# Application Environment
ENVIRONMENT=demo
SIMULATION_LABEL="SIMULATED SERVICE - NOT CONNECTED TO LIVE SYSTEMS"
APP_PORT=8000
WEB_PORT=3000

# Security & Session Authentication
SECRET_KEY=rebound_demo_super_secret_jwt_key_please_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seed User Credentials (Demo Mode)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword2026!
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=OperatorPassword2026!

# Database Configuration
# Supports SQLite (default for instant zero-dependency local runs) or PostgreSQL:
# SQLite: sqlite+aiosqlite:///./rebound.db
# PostgreSQL: postgresql+asyncpg://rebound:rebound_password@localhost:5432/rebound
DATABASE_URL=sqlite+aiosqlite:///./rebound.db

# Isolated Sandbox Runner Configuration
RUNNER_CONTROL_PORT=5005
RUNNER_DEMO_PORT=5006
RUNNER_CONTROL_URL=http://localhost:5005
RUNNER_DEMO_SERVICE_URL=http://localhost:5006
RUNNER_AUTH_TOKEN=rebound_runner_internal_token_secure_2026

# Monitor Worker Probing & Recovery Thresholds
HEALTH_CHECK_INTERVAL_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=2
CONSECUTIVE_FAILURES_TO_OPEN=3
CONSECUTIVE_SUCCESSES_TO_RESOLVE=2
AUTO_RECOVERY_COOLDOWN_SECONDS=60
MAX_AUTO_RECOVERY_ATTEMPTS=1

# Google Gemini API Configuration
# Leave blank to automatically use the labelled Deterministic Demo Fallback Analyzer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Enterprise Integration Placeholder (Finals Preparation)
GEMINI_ENTERPRISE_ENABLED=false
GEMINI_ENTERPRISE_WORKFLOW_ENDPOINT=
